geom_smooth(aes(x = impervious, y = psi_med, group = level, color = temp_min, linetype = as.factor(temp_min)),
method = "gam", se = FALSE)+
geom_ribbon(aes(x = impervious, y = psi_med, group = level, ymin = psi_lowCI, ymax = psi_uppCI, fill = temp_min),
